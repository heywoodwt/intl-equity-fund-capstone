# Copy to .env and fill in. .env is git-ignored.
# Free FRED API key (instant signup): https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# WRDS uses your username + PASSWORD (not an API key). The username isn't secret,
# so it's fine here; the password is cached in ~/.pgpass on first connect — never
# commit it. Leave blank to be prompted interactively.
WRDS_USERNAME=
