def tvp_kalman_alpha(
    port_ret: pd.Series,
    factors: pd.DataFrame,
    rf: pd.Series,
    n_factors: int = None,
    sigma_eta: float = 0.01,  # state noise
    sigma_eps: float = 0.02   # observation noise
):
    """
    TVP Factor Model via Kalman Filter (using pykalman).
    State: [alpha, beta_1, ..., beta_k]
    """
    from pykalman import KalmanFilter
    
    # Align
    common = port_ret.index.intersection(factors.index).intersection(rf.index)
    y = (port_ret - rf).loc[common].values
    X = factors.loc[common].values
    dates = common
    
    T, k = X.shape
    if n_factors is None:
        n_factors = k
    
    # State dimension: alpha + k betas
    n_state = 1 + n_factors
    
    # Transition matrix: identity (random walk)
    transition_matrix = np.eye(n_state)
    
    # Observation matrix: [1, x_t] for each t
    # pykalman expects (T, n_obs, n_state) or we use time-varying
    observation_matrices = np.zeros((T, 1, n_state))
    observation_matrices[:, 0, 0] = 1  # alpha coefficient
    observation_matrices[:, 0, 1:] = X[:, :n_factors]  # factor coefficients
    
    # Noise covariances
    transition_covariance = np.eye(n_state) * sigma_eta**2
    observation_covariance = np.array([[sigma_eps**2]])
    
    # Initial state: OLS estimate on first window
    init_window = min(252, T//4)
    X_init = sm.add_constant(X[:init_window])
    init_model = sm.OLS(y[:init_window], X_init).fit()
    initial_state_mean = init_model.params[:n_state]
    initial_state_covariance = np.eye(n_state) * 0.1
    
    # Kalman Filter
    kf = KalmanFilter(
        transition_matrices=transition_matrix,
        observation_matrices=observation_matrices,
        transition_covariance=transition_covariance,
        observation_covariance=observation_covariance,
        initial_state_mean=initial_state_mean,
        initial_state_covariance=initial_state_covariance,
        em_vars=['transition_covariance', 'observation_covariance']
    )
    
    # EM to estimate noise parameters
    kf = kf.em(y, n_iter=10)
    
    # Filter & Smooth
    state_means, state_covs = kf.filter(y)
    smoothed_means, smoothed_covs = kf.smooth(y)
    
    # Results
    state_names = ['alpha'] + list(factors.columns[:n_factors])
    
    filtered = pd.DataFrame(state_means, index=dates, columns=state_names)
    smoothed = pd.DataFrame(smoothed_means, index=dates, columns=state_names)
    
    # Add alpha annualized & significance
    for df in [filtered, smoothed]:
        df['alpha_annual'] = df['alpha'] * 252
        # Approximate t-stat from state covariance
        # For smoothed, use diagonal of cov
    
    return filtered, smoothed, kf

# Run TVP (using subset of factors for speed)
tvp_filtered, tvp_smoothed, kf_model = tvp_kalman_alpha(
    port_ret, factors[['MKT', 'SMB', 'HML']], rf,
    n_factors=3, sigma_eta=0.005, sigma_eps=0.015
)

print("=== TVP Kalman Filter Alpha ===")
print(f"Mean annual alpha (smoothed): {tvp_smoothed['alpha_annual'].mean():.2%}")
print(f"Alpha std: {tvp_smoothed['alpha_annual'].std():.2%}")
print(f"Final alpha: {tvp_smoothed['alpha_annual'].iloc[-1]:.2%}")